{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/d6z7/meaning-as-code/mac.shapes.schema.json",
  "title": "MAC shapes — meta-schema for constraint shape files",
  "description": "A shape file declares MAC constraints as data, run by tools/check_shapes.py. This meta-schema makes shape files themselves conformant (MAC's schema-driven discipline applied to its own constraint layer).",
  "type": "object",
  "required": ["shapes"],
  "additionalProperties": true,
  "properties": {
    "shapes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "target", "constraint"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "description": "stable kebab-case shape id" },
          "description": { "type": "string" },
          "target": { "type": "string", "enum": ["concept"], "description": "which node kind the shape applies to (currently: concept files)" },
          "where": {
            "type": "object",
            "description": "optional target filter — apply only to nodes where each path resolves to the given value (e.g. {concept.class: measure})",
            "additionalProperties": { "type": "string" }
          },
          "severity": { "type": "string", "enum": ["error", "warning", "info"], "default": "error" },
          "constraint": {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": true,
            "properties": {
              "kind": { "type": "string", "enum": ["required", "in", "subset_of", "rule_binds_grounded"], "description": "the closed constraint vocabulary" },
              "path": { "type": "string", "description": "(required/in) dotted path; `[]` flattens a list" },
              "min": { "type": "integer", "description": "(required) minimum count, default 1" },
              "values": { "type": "array", "description": "(in) the closed set of allowed values" },
              "left": { "type": "string", "description": "(subset_of) the path whose values must be a subset" },
              "right": {
                "description": "(subset_of) the path(s) whose union the left must be within",
                "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
              }
            }
          }
        }
      }
    }
  }
}
