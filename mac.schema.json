{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/d6z7/meaning-as-code/mac.schema.json",
  "title": "Meaning-as-Code (MAC) — formal schema v0.5",
  "description": "The strict, machine-checkable contract for MAC YAML files across the four layers (Concept, Rules, Edges, Physical/Tables). The CORE vocabulary is closed: unknown keys are rejected. Project-specific extensions are permitted ONLY under the 'x-' namespace (see CONFORMANCE.md). This schema is the normative companion to FRAMEWORK.md (the why) and CONCEPT_SPEC.md (the prose reference); where they disagree, FRAMEWORK.md governs intent and this schema governs syntax. v0.5 changes are recorded in CONFORMANCE.md §changelog.",
  "$comment": "A MAC file is one of four file types, distinguished by its discriminator key: concept files have 'concept:', rules files 'rules:', edges files 'edges:', table files 'table:'. A validator selects the matching $def by file location; the root oneOf also resolves it structurally.",

  "oneOf": [
    { "$ref": "#/$defs/ConceptFile" },
    { "$ref": "#/$defs/RulesFile" },
    { "$ref": "#/$defs/EdgesFile" },
    { "$ref": "#/$defs/TableFile" }
  ],

  "$defs": {

    "confidence": {
      "description": "Trust tier (pluggable scale; GAPS uses C/I/Q). C confirmed · I inferred · Q needs-SME.",
      "enum": ["C", "I", "Q"]
    },

    "status": { "enum": ["production", "draft", "prototype"] },

    "changeLogEntry": {
      "type": "object",
      "required": ["date", "change", "change_type"],
      "properties": {
        "date": { "description": "ISO date — string or a YAML-parsed date" },
        "change": { "type": "string" },
        "change_type": { "enum": ["CREATION", "ADDITION", "CORRECTION", "REMOVAL", "REFACTOR"] },
        "by": { "type": "string" },
        "rationale": { "type": "string" }
      },
      "additionalProperties": false
    },

    "governance": {
      "type": "object",
      "description": "Housekeeping. APPEND-ONLY — never edit change_log history.",
      "properties": {
        "owner": { "type": "string" },
        "last_reviewed": { "description": "ISO date — string or a YAML-parsed date" },
        "approval_status": { "type": "string" },
        "change_log": { "type": "array", "items": { "$ref": "#/$defs/changeLogEntry" } }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },

    "openQuestion": {
      "type": "object",
      "required": ["id", "question"],
      "properties": {
        "id": { "type": "string" },
        "topic": { "type": "string" },
        "question": { "type": "string" },
        "status": { "enum": ["OPEN", "PARTIAL", "RESOLVED", "NEEDS_SME_CONFIRMATION"] },
        "owner_for_resolution": { "type": "string" },
        "priority": { "type": "string" },
        "category": { "type": "string" },
        "note": { "type": "string" },
        "cross_references": { "type": ["array", "string"] }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },

    "additivityAxis": {
      "description": "v0.5: canonical values are 'additive' / 'non-additive' (hyphen). The legacy underscore 'non_additive' is a Phase-C conformance fix.",
      "enum": ["additive", "non-additive"]
    },

    "semantics": {
      "type": "object",
      "description": "The SINGLE home for interpretive reasoning facts (FRAMEWORK §5).",
      "properties": {
        "purpose": { "type": "string" },
        "scope": { "type": "string" },
        "additivity": {
          "type": "object",
          "description": "Per-dimension aggregation rule — the footgun-preventer. v0.5: absorbs the former 'additivity_contract' (DECISION 0). Axis names are DOMAIN-SPECIFIC (GAPS: time/geography/model; a shop: customer/product) — any axis name maps to an additivity value. A stock measure is non-additive over time.",
          "additionalProperties": { "$ref": "#/$defs/additivityAxis" }
        },
        "unit": { "type": "string" },
        "null_semantics": { "type": "string" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },

    "contract": {
      "type": ["string", "object"],
      "description": "v0.5 NEW core construct (DECISION 0). The agent-facing binding rules for using this concept correctly — the resolution of the framework's deferred 'reasoning_guidance:' question. Absorbs the former *_contract family + no_probe_guarantee + grounding.guarantees. May be a free-text guidance STRING (shorthand) or a structured object with the sub-keys below; all optional.",
      "properties": {
        "no_probe_guarantee": {
          "type": "string",
          "description": "What an agent needs ONLY, to use this concept without probing the data; if more is needed, the concept is incomplete (fix it, don't probe). Was 'no_probe_guarantee'."
        },
        "resolution": {
          "type": ["string", "object"],
          "description": "How identity / name→code resolves (a join, not a probe). Was name_contract / resolution_contract / identity_contract."
        },
        "default_reading": {
          "type": ["string", "object"],
          "description": "The default aggregation / role / perspective to assume when the question is silent. Was aggregation_contract."
        },
        "answer_rules": {
          "type": ["string", "object"],
          "description": "Binding constraints on answering — which definition to use, what to emit, what to refuse. Was answer_contract."
        },
        "axis_handling": {
          "type": ["string", "object"],
          "description": "How to treat time / orthogonal axes for this concept. Was time_contract / two_axes_contract (the structural part stays in semantics)."
        }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },

    "grounding": {
      "type": "object",
      "description": "Thin pointer to where the data lives (FRAMEWORK §5). Column metadata stays in the Physical layer — v0.5 removed concept/grounding-level 'columns' (single-homing). Profile-specific annotations go under 'x-'.",
      "properties": {
        "kind": { "type": "string", "description": "Grounding adapter (pluggable): sql_table | api | file | graph." },
        "table": { "type": "string" },
        "tables": { "type": "array" },
        "primary_tables": { "type": "array" },
        "schema": { "type": "string" },
        "key_column": { "type": "string" },
        "code_column": { "type": "string" },
        "value_filter": { "type": "string" },
        "join_rule": { "type": "string" },
        "discriminator": { "type": "string" },
        "snapshot_rule": { "type": "string" },
        "family_resolution": { "type": "string" },
        "row_count": { "type": ["integer", "string"] },
        "used_in": { "type": ["array", "string"] },
        "serves_from": { "type": ["string", "array"], "description": "v0.5 PROMOTED to core: the serving-view .sql file(s) this concept is served from (a string, or a list when several views back one concept)." },
        "grain": { "type": "string", "description": "v0.5 PROMOTED to core: the committed leaf grain — one row = one ... . THE grain-commitment lesson, first-class." },
        "grounds_column": { "type": "string", "description": "(naming contract) a physical column name as a VALUE, never a key." },
        "note": { "type": "string" },
        "notes": { "type": "string" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },

    "constraintEntry": {
      "type": "object",
      "description": "A data-quality invariant (validation, NOT derivation). The description field is 'assert:', never 'rule:'.",
      "required": ["assert"],
      "properties": {
        "assert": { "type": "string" },
        "severity": { "enum": ["ERROR", "WARNING", "INFORMATIONAL"] },
        "machine_executable": { "type": "boolean" },
        "sql_assertion": { "type": "string" },
        "open_question": { "type": "string" },
        "notes": { "type": "string" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },

    "enumerationValues": {
      "type": "object",
      "description": "v0.5: 'values:' is the SINGLE carrier for an enumeration's value set + closure ('value_set:' was dropped, DECISION 3). Closure lives HERE, with the values — never in semantics.",
      "properties": {
        "closure": { "enum": ["closed", "open", "unknown"] },
        "closure_why": { "type": "string" },
        "items": { "type": "array" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },

    "ConceptFile": {
      "type": "object",
      "required": ["metadata", "concept"],
      "properties": {
        "metadata": {
          "type": "object",
          "required": ["concept", "source", "schema_version"],
          "properties": {
            "concept": { "type": "string" },
            "source": { "type": "string" },
            "version": { "type": "string" },
            "schema_version": { "type": "string" },
            "benchmark_baseline": { "type": "string" },
            "status": { "$ref": "#/$defs/status" },
            "owner": { "type": "string" },
            "confidence": { "$ref": "#/$defs/confidence" }
          },
          "patternProperties": { "^x-": true },
          "additionalProperties": false
        },
        "concept": {
          "type": "object",
          "required": ["name", "class"],
          "properties": {
            "name": { "type": "string", "description": "PascalCase ontology id — the single canonical identifier." },
            "label": { "type": "string" },
            "german": { "type": "string" },
            "class": {
              "enum": ["entity", "event", "measure", "enumeration", "reference", "grouping"],
              "description": "The closed six-class vocabulary. Never invent a seventh."
            },
            "definition": { "type": "string" },
            "semantics": { "$ref": "#/$defs/semantics" },
            "notes": { "type": "string" },
            "grounded_by": { "type": "string", "description": "(enumerations) the discriminator column the values come from." },
            "related_axis": { "type": "string" }
          },
          "patternProperties": { "^x-": true },
          "additionalProperties": false
        },

        "contract": { "$ref": "#/$defs/contract" },

        "values": { "$ref": "#/$defs/enumerationValues" },
        "properties": { "type": "array", "description": "Intrinsic PRIMITIVE attributes (string/int/date). Concept-typed relations are edges, not properties." },
        "attributes": { "type": "array", "description": "EAV-read attributes constrained by an enumeration (value_domain). Distinct from 'properties' (primitive)." },
        "subclasses": { "type": "array", "description": "is-a hierarchy (e.g. measure Flow/Stock/Target)." },
        "instances": { "type": "array" },
        "members": { "type": "array", "description": "whole→part containment on the container. Containment is concept structure, not an edge." },
        "members_resolution": { "type": ["string", "object"] },
        "enumerations": { "type": "array", "description": "list of enum sub-blocks when a concept carries several coded columns." },
        "related_concepts": { "type": "array" },
        "lifecycle": {
          "type": "object",
          "description": "(event class) the state machine: phases group states, in sequence. Descriptive — recorded, not executed.",
          "properties": {
            "phase_sequence": { "type": "array" },
            "phases": { "type": "array" },
            "phase_closure": {},
            "states": {},
            "boundary": {},
            "note": { "type": "string" }
          },
          "patternProperties": { "^x-": true },
          "additionalProperties": false
        },
        "individual_kpis": { "type": "array", "description": "(measure catalogue) concrete measures, each referencing a measure_type + own semantics." },
        "derived_by_rule": { "type": "string", "description": "marks a concept whose value is produced by a rule; the formula lives in rules.yaml (single-homing), this only names it." },

        "grounding": { "$ref": "#/$defs/grounding" },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraintEntry" } },
        "governance": { "$ref": "#/$defs/governance" },
        "open_questions": { "type": "array", "items": { "$ref": "#/$defs/openQuestion" } }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },

    "RulesFile": {
      "type": "object",
      "required": ["rules"],
      "properties": {
        "metadata": { "type": "object" },
        "governance": { "$ref": "#/$defs/governance" },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule", "derives", "over", "logic", "render_kind"],
            "description": "v0.5: render_kind is REQUIRED. The 'formula' family was dropped → use template/logic (DROP→template).",
            "properties": {
              "rule": { "type": "string" },
              "derives": { "type": "string" },
              "over": { "type": ["array", "string"] },
              "logic": { "type": "string" },
              "render_kind": { "enum": ["sql_expression", "sql_view", "derived_set", "spark_udf", "spec_only"] },
              "template": { "type": "string" },
              "view_ref": { "type": "string" },
              "usage_template": { "type": "string" },
              "requires_join": { "type": "string" },
              "relative_template": { "type": "string" },
              "applied_as": { "type": "string" },
              "closure": {},
              "disambiguation": {},
              "validated_against": { "type": ["array", "string"] },
              "conditions": {},
              "edge_cases": {},
              "inspectable": { "type": "boolean" },
              "confidence": { "$ref": "#/$defs/confidence" },
              "cross_references": { "type": ["array", "string"] }
            },
            "patternProperties": { "^x-": true },
            "additionalProperties": false,
            "allOf": [
              { "if": { "properties": { "render_kind": { "enum": ["sql_expression", "derived_set"] } } },
                "then": { "required": ["template"], "$comment": "an injected rule must carry its canonical SQL template" } },
              { "if": { "properties": { "render_kind": { "const": "sql_view" } } },
                "then": { "required": ["view_ref"], "$comment": "a view-backed rule must reference the pre-deposited view" } }
            ]
          }
        }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },

    "EdgesFile": {
      "type": "object",
      "required": ["edges"],
      "properties": {
        "metadata": { "type": "object" },
        "governance": { "$ref": "#/$defs/governance" },
        "planned_edges": { "type": "array" },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["level", "type", "endpoints"],
            "description": "v0.5: edge type must be LEGAL for its level. Illegal types 'denormalized' and 'literal_equal' were removed (denormalized → not an edge; literal_equal → value_mapped_key).",
            "properties": {
              "edge_id": { "type": "string" },
              "level": { "enum": ["physical", "business", "federation"] },
              "type": { "type": "string" },
              "endpoints": {
                "type": "object",
                "required": ["from", "to"],
                "properties": { "from": { "type": "object" }, "to": { "type": "object" } },
                "patternProperties": { "^x-": true },
                "additionalProperties": false
              },
              "join_rule": { "type": "string" },
              "realized_by": {},
              "conditions": {},
              "confidence": { "$ref": "#/$defs/confidence" },
              "federation_concept_id": { "type": "string" },
              "notes": { "type": "string" },
              "cross_references": { "type": ["array", "string"] }
            },
            "allOf": [
              { "if": { "properties": { "level": { "const": "physical" } } },
                "then": { "properties": { "type": { "enum": ["foreign_key", "composite_key", "value_mapped_key"] } } } },
              { "if": { "properties": { "level": { "const": "business" } } },
                "then": { "properties": { "type": { "const": "identity" } }, "required": ["realized_by"] } },
              { "if": { "properties": { "level": { "const": "federation" } } },
                "then": { "properties": { "type": { "const": "same_real_world_event" } }, "required": ["conditions", "confidence"] } }
            ],
            "patternProperties": { "^x-": true },
            "additionalProperties": false
          }
        }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },

    "TableFile": {
      "type": "object",
      "required": ["table", "columns"],
      "properties": {
        "metadata": { "type": "object" },
        "table": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "schema": { "type": "string" },
            "type": { "enum": ["table", "view", "materialized_view"] },
            "description": { "type": "string" },
            "confidence": { "$ref": "#/$defs/confidence" }
          },
          "patternProperties": { "^x-": true },
          "additionalProperties": false
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "role"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "role": {
                "enum": ["primary_key", "foreign_key", "value", "discriminator", "audit", "composite_key_part", "unknown"],
                "description": "v0.5 (DECISION 4): the canonical PHYSICAL role set is kept. FPL_CLEAN's analytical roles (dimension/measure/attribute) are mapped down to this in Phase C; they do NOT enter the schema. 'unknown' is forbidden in production-status files (enforced separately)."
              },
              "description": { "type": "string" },
              "confidence": { "$ref": "#/$defs/confidence" },
              "nullable": { "type": "boolean" },
              "notes": { "type": "string" },
              "enum_ref": { "type": "string" }
            },
            "patternProperties": { "^x-": true },
            "additionalProperties": false
          }
        },
        "foreign_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "from_column", "to_table", "to_column"],
            "properties": {
              "name": { "type": "string" },
              "from_column": { "type": "string" },
              "to_table": { "type": "string" },
              "to_column": { "type": "string" },
              "enforced": { "type": "boolean" },
              "required": { "type": "boolean" },
              "cardinality_at_to": { "type": "string" },
              "confidence": { "$ref": "#/$defs/confidence" },
              "notes": { "type": "string" }
            },
            "patternProperties": { "^x-": true },
            "additionalProperties": false
          }
        },
        "grounded_by_concepts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "concept": { "type": "string" },
              "ref": { "type": "string" },
              "role": { "type": "string", "description": "descriptive reverse-pointer role (e.g. primary_table, referenced, discriminator_column) — free text, not a load-bearing controlled vocabulary." }
            },
            "patternProperties": { "^x-": true },
            "additionalProperties": false
          }
        },
        "governance": { "$ref": "#/$defs/governance" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    }

  }
}
