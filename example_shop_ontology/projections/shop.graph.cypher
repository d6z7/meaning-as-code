// MAC -> property-graph (openCypher) projection of 'shop'. Generated by mac_to_graph.py — do not edit.
// 4 node labels, 2 relationship types. Concepts of class measure/enumeration are not nodes.

// --- node key constraints (runnable Cypher) ---
CREATE CONSTRAINT category_key IF NOT EXISTS FOR (n:Category) REQUIRE n.category_id IS UNIQUE;
CREATE CONSTRAINT product_key IF NOT EXISTS FOR (n:Product) REQUIRE n.sku IS UNIQUE;
CREATE CONSTRAINT customer_key IF NOT EXISTS FOR (n:Customer) REQUIRE n.customer_id IS UNIQUE;
CREATE CONSTRAINT order_key IF NOT EXISTS FOR (n:Order) REQUIRE n.order_id IS UNIQUE;

// --- node properties (schema; * = key) ---
