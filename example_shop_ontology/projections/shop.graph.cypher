//   (:Product {sku*, name, category_id, list_price})   <- products
//   (:Customer {customer_id*, email, created_at})   <- customers
//   (:Order {order_id*, customer_id, status, placed_at, paid_at, shipped_at, delivered_at, gross_amount})   <- orders

// --- relationships (from MAC edges; FK columns become traversals) ---
