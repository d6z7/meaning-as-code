.DS_Store
__pycache__/
*.pyc

# Python packaging build artifacts (pyproject.toml, added 2026-09-10)
build/
dist/
*.egg-info/

# A compile writes the schema description text into this file, and that text carries
# customer identifiers — so a compile in a fresh clone produces a committable public leak.
# It is a build artifact: regenerate it with `mac-compile <bundle>`, never commit it.
compile.json
**/compile.json

# The infra-handle register is per-estate and must never be published: a detector that
# names what it forbids is a register of those secrets. Only the .example ships.
sdk/gate/infra_handles.txt

# The source-token register is per-estate and must never be published — same rule as the
# infra-handle register. Only the .example ships.
sdk/gate/source_tokens.txt

# The shared-schema register is per-estate — same rule as the other two.
sdk/gate/shared_schemas.txt

# The public-token register IS the identity it protects. Never tracked.
registers/public_tokens.txt

# The estate's own vocabulary — the words it uses for its KPIs, and the source columns that stamp
# when a figure was published. Framework heuristics need them; a public repository must not carry
# them. These four sites were the last real leaks check_mac_public found (2026-09-17). Only the
# .example ships, with the format and no values.
registers/estate_terms.txt


# Agent worktrees. A workflow may register a git worktree of this repo under .claude/worktrees/,
# checked out at another commit. It must never be staged: git would record it as a gitlink to an
# embedded repository, and the checkout can predate a scrub of this tree.
.claude/

# The ontology lock-disarm marker. It is the OPERATOR's, it is created by hand, and it must
# never travel: committed, it would arrive disarmed in every clone. Ignored so that a
# `git add -A` in a bundle where the operator has unlocked cannot carry it in.
.ontology-unlocked
