.DS_Store
__pycache__/
*.pyc

# Python packaging build artifacts (pyproject.toml, added 2026-09-10)
build/
dist/
*.egg-info/

# A compile writes the schema description text into this file, and that text carries
# customer identifiers — so a compile in a fresh clone produces a committable public leak.
# It is a build artifact: regenerate it with `mac-compile <bundle>`, never commit it.
compile.json
**/compile.json

# The infra-handle register is per-estate and must never be published: a detector that
# names what it forbids is a register of those secrets. Only the .example ships.
sdk/gate/infra_handles.txt

# The source-token register is per-estate and must never be published — same rule as the
# infra-handle register. Only the .example ships.
sdk/gate/source_tokens.txt

# The shared-schema register is per-estate — same rule as the other two.
sdk/gate/shared_schemas.txt

# The public-token register IS the identity it protects. Never tracked.
registers/public_tokens.txt

